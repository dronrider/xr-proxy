#!/bin/sh /etc/rc.common
START=98
STOP=11
USE_PROCD=1

start_service() {
    test -r /etc/xr-proxy/wan-pool.conf || return 0
    procd_open_instance
    procd_set_param command /usr/bin/wan-pool-watch.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    /usr/bin/wan-pool-cleanup.sh
}

service_triggers() {
    procd_add_reload_trigger network firewall
}
