<?xml version="1.0" encoding="utf-8"?>
<!--
  Передний слой иконки лаунчера: щит с вырезанной молнией.

  Геометрия та же, что рисует ShieldArrowIcon на главном экране, только
  пересчитанная из системы 100x120 в 108x108. Иначе иконка приложения и
  иконка в лаунчере разъезжаются формой, о чём LLD-06 и предупреждает в
  разделе 5.

  Размер выбран так, чтобы силуэт целиком лёг в safe zone adaptive-иконки:
  круг диаметром 66 в центре холста. Самая дальняя точка контура это 32.15
  от центра при допустимых 33, поэтому круглая маска ничего не срежет.
  Прежний вектор был крупнее (верхние углы уходили на 43) и терял их на
  круглых масках, а молния торчала за пределы щита.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Щит: сплошная заливка primary -->
    <path
        android:fillColor="#22D3EE"
        android:pathData="
            M33.4,30.94
            Q33.4,28.0 36.34,28.0
            L71.66,28.0
            Q74.6,28.0 74.6,30.94
            L74.6,50.57
            Q74.6,67.25 54.0,80.0
            Q33.4,67.25 33.4,50.57
            Z" />

    <!-- Молния: вырезана цветом фона, тем же, что у background-слоя -->
    <path
        android:fillColor="#0B1220"
        android:pathData="
            M57.92,36.83
            L45.66,57.43
            L52.53,57.43
            L49.58,72.15
            L62.83,50.57
            L55.47,50.57
            Z" />
</vector>
