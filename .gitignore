.DS_Store
target
# Кросс-сборка под windows (xr-share.d) отдельным CARGO_TARGET_DIR.
target-win
xr-server/.vscode/launch.json
/logs/
tmp/
# Локальные доки с чувствительными данными (IP/доступы инфры) в git не едут.
local-docs/
CLAUDE.local.md
# Сборочные артефакты APK в репозитории не храним.
*.apk

# Локальная обвязка выката, живёт только на машине: адреса инфры в самих
# скриптах, канонические версии с адресами из local-docs лежат в scripts/.
.devkit/*.local
.devkit/deploy-*.sh
release-staging/

# Побочный продукт питоньей оснастки в tools/
__pycache__/

# Журналы запусков инструментов devkit и лок выката, живут только на машине.
.devkit/log
.devkit/goal-*.log
.devkit/ship.lock
